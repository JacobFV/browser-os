{
  "name": "browser-os",
  "version": "0.1.0",
  "private": true,
  "description": "A monorepo for browser-based operating system UI components",
  "workspaces": [
    "packages/*",
    "examples/*"
  ],
  "scripts": {
    "build": "pnpm --recursive build",
    "dev": "pnpm --recursive dev",
    "test": "pnpm --recursive test",
    "lint": "pnpm --recursive lint",
    "clean": "pnpm --recursive clean && pnpm store prune"
  },
  "keywords": [
    "monorepo",
    "react",
    "component-library",
    "browser-os",
    "ui"
  ],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "typescript": "^5.3.0"
  },
  "engines": {
    "node": ">=18.0.0",
    "pnpm": ">=8.0.0"
  }
}

