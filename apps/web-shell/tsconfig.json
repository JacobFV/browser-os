{
  "compilerOptions": {
    "target": "ES2020",
    "useDefineForClassFields": true,
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "baseUrl": ".",
    "paths": {
      "@system-apps/files/*": ["../../system-apps/files/src/*"],
      "@system-apps/terminal/*": ["../../system-apps/terminal/src/*"],
      "@system-apps/notes/*": ["../../system-apps/notes/src/*"],
      "@system-apps/calculator/*": ["../../system-apps/calculator/src/*"],
      "@system-apps/monitor/*": ["../../system-apps/monitor/src/*"],
      "@system-apps/settings/*": ["../../system-apps/settings/src/*"],
      "@system-apps/word-processor/*": ["../../system-apps/word-processor/src/*"],
      "@apps/web-shell/*": ["./src/*"]
    }
  },
  "include": ["src"],
  "references": [{ "path": "./tsconfig.node.json" }]
}

