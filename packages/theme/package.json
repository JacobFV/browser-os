{
  "name": "@browser-os/theme",
  "version": "0.1.0",
  "private": true,
  "description": "Theme tokens and skin presets for browser-os",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    },
    "./tokens": "./dist/tokens.js",
    "./win95": "./dist/win95.css",
    "./macos": "./dist/macos.css",
    "./monaco": "./dist/monaco.css",
    "./glass": "./dist/glass.css"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "lint": "eslint src --ext ts",
    "clean": "rm -rf dist"
  },
  "dependencies": {},
  "devDependencies": {
    "tsup": "^8.0.0",
    "typescript": "^5.3.0"
  }
}

