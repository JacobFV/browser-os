{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "outDir": "./dist",
    "rootDir": "./src",
    "moduleResolution": "node",
    "skipLibCheck": true,
    "jsx": "react-jsx",
    "baseUrl": ".",
    "paths": {
      "@system-apps/terminal": ["../../system-apps/terminal/src"],
      "@system-apps/calculator": ["../../system-apps/calculator/src"],
      "@system-apps/files": ["../../system-apps/files/src"],
      "@system-apps/notes": ["../../system-apps/notes/src"],
      "@system-apps/monitor": ["../../system-apps/monitor/src"],
      "@system-apps/settings": ["../../system-apps/settings/src"],
      "@system-apps/editor": ["../../system-apps/editor/src"],
      "@system-apps/browser": ["../../system-apps/browser/src"],
      "@system-apps/calendar": ["../../system-apps/calendar/src"],
      "@system-apps/store": ["../../system-apps/store/src"]
    }
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "dist"]
}

