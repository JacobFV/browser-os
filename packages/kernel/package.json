{
  "name": "@browser-os/kernel",
  "version": "0.1.0",
  "description": "Kernel with syscall routing, permissions, and security",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "tsc",
    "clean": "rm -rf dist",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@browser-os/schemas": "workspace:*",
    "@browser-os/events": "workspace:*",
    "@browser-os/fs": "workspace:*",
    "@browser-os/proc": "workspace:*",
    "@browser-os/app-registry": "workspace:*",
    "@browser-os/windowing": "workspace:*",
    "@browser-os/notifications": "workspace:*",
    "@browser-os/dialogs": "workspace:*",
    "@browser-os/clipboard": "workspace:*",
    "@browser-os/storage": "workspace:*",
    "@browser-os/network": "workspace:*",
    "@browser-os/system": "workspace:*",
    "@browser-os/power": "workspace:*"
  },
  "devDependencies": {
    "typescript": "^5.3.0",
    "vitest": "^1.0.0"
  }
}

